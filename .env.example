# CodeBase Navigator AI - Environment Configuration Example
# Copy this file to .env and customize values for your deployment.

# Application Settings
APP_NAME=CodeBase Navigator AI
APP_ENV=development
DEBUG=True
SECRET_KEY=generate_a_secure_random_key_for_production_min_32_chars
HOST=127.0.0.1
PORT=5000

# Database Configuration (SQLite default, PostgreSQL ready)
DATABASE_URL=sqlite:///instance/codebase_navigator.db
# DATABASE_URL=postgresql://user:password@localhost:5432/codebase_navigator

# Session & JWT Security
JWT_SECRET_KEY=generate_a_secure_jwt_secret_min_32_chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Storage & Upload Quotas
STORAGE_BASE_DIR=storage
MAX_CONTENT_LENGTH_MB=100
MAX_PROJECT_FILES=15000
MAX_FILE_SIZE_MB=10
ALLOWED_ARCHIVE_EXTENSIONS=.zip,.tar.gz,.tgz,.tar

# Code Analysis Engine Limits
MAX_PARSER_DEPTH=50
MAX_GRAPH_NODES=2500
ANALYSIS_TIMEOUT_SECONDS=300
ENABLE_PARALLEL_ANALYSIS=True
MAX_WORKER_THREADS=4

# Optional AI Copilot Configuration
# Supported providers: offline (default deterministic), openai, anthropic, gemini, ollama
AI_PROVIDER=offline
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL_NAME=
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# Logging
LOG_LEVEL=INFO
LOG_FILE=storage/app.log
